  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web && node scripts/prepare-web-dist.js",
    "predeploy": "npm run export:web",
    "deploy": "gh-pages --nojekyll -d dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --watchAll=false"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
