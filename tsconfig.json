{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "jest"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@app/*": [
        "app/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.native.ts",
    "**/*.native.tsx"
  ]
}
